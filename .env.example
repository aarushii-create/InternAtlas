# PostgreSQL 16 with the pgvector extension enabled.
DATABASE_URL=postgresql://internatlas:change-me@localhost:5432/internatlas
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# Local-only password used by docker-compose.yml. Set a strong secret in production.
POSTGRES_PASSWORD=change-me

# Replace this with a unique random secret of at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-secret
# Generate a separate 32-byte key for encrypting persisted application state.
APP_DATA_ENCRYPTION_KEY=
# Generate a separate 32-byte key for encrypting database backup files.
BACKUP_ENCRYPTION_KEY=
# Optional comma-separated account IDs allowed to manage shared ingestion and alert configuration.
ADMIN_USER_IDS=
# Required to enable the Telegram feedback webhook. Configure the same value in Telegram's webhook secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Production live ingestion requires source-specific terms review and explicit opt-in.
ATS_TERMS_REVIEWED=false
ENABLE_LIVE_SCRAPING=false
ENABLE_SCRAPER_SCHEDULER=false

# Optional public base URL for hosted deployments.
APP_URL=http://localhost:3000

# Reserved for future evaluation/provider configuration; not currently implemented.
EMBEDDING_PROVIDER=
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
